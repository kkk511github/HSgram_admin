ADMIN_LISTEN_ADDR=:8088
ADMIN_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/teamgram?charset=utf8mb4&parseTime=true&loc=Local
ADMIN_ENABLE_BROADCASTS=true
# 留空则启动时不连 msg，广播投递不可用；需要投递时填写（本地常见 127.0.0.1:20030）
ADMIN_MSG_RPC_ADDR=127.0.0.1:20030
ADMIN_AUTHSESSION_RPC_ADDR=127.0.0.1:20450
ADMIN_RELEASES_DIR=./releases
ADMIN_PUBLIC_BASE_URL=http://127.0.0.1:8088
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_TTL=12h
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
# Large APK uploads on slow links need long read/write windows (Go http.Server).
ADMIN_HTTP_READ_TIMEOUT=30m
ADMIN_HTTP_WRITE_TIMEOUT=30m
