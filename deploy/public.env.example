ADMIN_IMAGE=hsgram_admin-admin-api:latest
ADMIN_SITE_ADDRESS=admin.example.com

# If admin joins the existing HSgram docker network, prefer mysql:3306 and the teamgram container name.
# If MySQL or msg service lives elsewhere, replace the host below.
ADMIN_DATABASE_DSN=teamgram:teamgram@tcp(mysql:3306)/teamgram?charset=utf8mb4&parseTime=true&loc=Local
# Only needed when ADMIN_ENABLE_BROADCASTS=true.
ADMIN_ENABLE_BROADCASTS=false
ADMIN_MSG_RPC_ADDR=hsgram_server-teamgram-1:20030

ADMIN_JWT_SECRET=replace-with-a-very-long-random-secret
ADMIN_TOKEN_TTL=12h

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-now
