{$ADMIN_SITE_ADDRESS} {
	encode gzip zstd
	log

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	@invite path_regexp invite ^/\+([A-Za-z0-9_-]+)$
	handle @invite {
		redir tg://join?invite={re.invite.1}
	}

	@autoMessages path_regexp autoMessages ^/groups/[0-9]+/auto-messages(/.*)?$
	handle @autoMessages {
		reverse_proxy hsgram_server-teamgram-1:8802
	}

	reverse_proxy admin-api:8088 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}
