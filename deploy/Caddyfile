{$ADMIN_SITE_ADDRESS} {
	encode gzip zstd
	log

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	reverse_proxy admin-api:8088 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}
